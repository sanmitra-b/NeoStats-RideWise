# Paths may be absolute; original pack remains read only.
RIDEWISE_DATA_DIR=D:/NeoStatsH/Neostats Hackathon AI Usecase 3/Neostats Hackathon AI Usecase

# Use ONLY the event-provided endpoint/key/model. No alternate provider fallback.
NEOSTATS_BASE_URL=
NEOSTATS_API_KEY=
NEOSTATS_MODEL=
MODEL_TIMEOUT_SECONDS=25

# Firebase web configuration is public. Admin service-account JSON is private.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
GOOGLE_APPLICATION_CREDENTIALS=
CUSTOMER_MAPPING_FILE=D:/NeoStatsH/secrets/customer_mapping.json

# If the event supplies an embedding model, set its exact name. Never use a personal provider.
NEOSTATS_EMBEDDING_MODEL=
# Used only when no embedding model is supplied (brief FAQ exception).
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
